REDMINE_URL=https://your-redmine.example.com
REDMINE_API_KEY=your_redmine_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
WEBHOOK_SECRET=your_webhook_secret_token
DASHBOARD_PASSWORD=your_dashboard_password
ISSUE_DETECTION_MODE=webhook   # webhook | polling
ENABLE_AUTO_COMMENT=false      # true로 설정해야 Redmine 댓글 자동 작성 활성화 (기본 비활성화)
CATEGORY_LIST=버그,기능요청,문의,성능,보안
CLASSIFICATION_THRESHOLD=0.7
REDMINE_CATEGORY_FIELD_ID=     # Redmine 커스텀 필드 ID (카테고리 태깅용, 없으면 비워둠)
SIMILARITY_THRESHOLD=0.3
DUPLICATE_THRESHOLD=0.9
MAX_SIMILAR_ISSUES=5
ISSUE_SEARCH_DAYS=365
# Sprint 3 추가
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
